{
  "$schema": "https://biomejs.dev/schemas/2.6.9/schema.json",
  "extends": ["./packages/lint/config.json"],
  "files": {
    "includes": ["packages/**", "examples/**", "*.ts", "!**/dist", "!**/node_modules", "!**/.super"]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 140 },
  "javascript": {
    "formatter": { "quoteStyle": "single", "trailingCommas": "all", "semicolons": "always", "arrowParentheses": "always" }
  },
  "css": { "formatter": { "enabled": false } },
  "linter": { "enabled": false }
}
