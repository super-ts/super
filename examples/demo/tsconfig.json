{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    // `paths` replaces the root tsconfig's: the Super packages again (resolved by alias in this
    // repository), then the app's two aliases, the ones the Super plugin declares to Vite.
    "paths": {
      "@super-ts/core/internal": ["../../packages/core/src/internal.ts"],
      "@super-ts/core": ["../../packages/core/src/index.ts"],
      "@super-ts/dom/internal": ["../../packages/dom/src/internal.ts"],
      "@super-ts/dom": ["../../packages/dom/src/index.ts"],
      "@super-ts/testing": ["../../packages/testing/src/index.ts"],
      "@super-ts/ui": ["../../packages/ui/src/index.ts"],
      "@core/*": ["./src/@core/*", "./.super/types/src/@core/*"],
      "@components/*": ["./src/@components/*", "./.super/types/src/@components/*"]
    },
    // The declarations of .super files (written by super-tsc, the .super server and Vite in dev):
    // a .ts that imports a .super component finds its types, and its definition leads to the .super.
    "rootDirs": ["./src", "./.super/types/src", "./.super/virtual/src"]
  },
  "include": ["src", "../../vitest.setup.ts"]
}
