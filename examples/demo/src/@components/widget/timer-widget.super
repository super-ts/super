import { SuperElement } from '@super-ts/dom';
import { TimerShortcuts } from './timer-shortcuts';
import './timer-widget.css';

/** The timer, rendered in its own application (see widgets/timer-widget.ts). */
export class TimerWidget extends SuperElement {
  @tag = 'timer-widget';

  @contract timer;
  @selector label = this.timer.selectors.label;
  @selector running = this.timer.selectors.running;
  #interval: ReturnType<typeof setInterval> | undefined;

  // The interval lives between the widget's mount and unmount.
  protected override mounted() {
    this.#interval = setInterval(() => this.timer.send('tick'), 1000);
  }

  protected override unmounted() {
    clearInterval(this.#interval);
  }

  render() {
    <div class="timer" role="group" aria-label="Timer">
      <output aria-label="Elapsed time">{this.label.value}</output>
      <button type="button" on:click={() => this.timer.send('toggle')}>{this.running.value ? 'Pause' : 'Start'}</button>
      <button type="button" on:click={() => this.timer.send('reset')}>Reset</button>
      <TimerShortcuts />
    </div>
  }
}
