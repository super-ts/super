import { SuperElement } from '@super-ts/dom';
import { mountTimerWidget } from '../../widgets/timer-widget';
import './index.css';

/** Screen of the `/widget` route: opens and closes a widget that lives in its own application. */
export class WidgetScreen extends SuperElement {
  @tag = 'widget-screen';
  @title = 'Widget';

  @state local = { open: false };
  @ref widgetSlot: HTMLElement;
  #close: (() => void) | null = null;

  toggle = () => {
    if (this.#close) {
      this.#close();
      this.#close = null;
      this.local.set({ open: false });
      return;
    }
    this.#close = mountTimerWidget(this.widgetSlot.value!);
    this.local.set({ open: true });
  };

  protected override unmounted() {
    this.#close?.();
    this.#close = null;
  }

  render() {
    <main class="screen">
      <h1>Widget</h1>
      <p class="hint">
        The timer below is a second application, mounted on its own element with its own store. Closing it releases the application and the
        store.
      </p>
      <button type="button" on:click={this.toggle}>{this.local.get().open ? 'Close the timer' : 'Open the timer'}</button>
      <div class="widget-slot" ref={this.widgetSlot}></div>
    </main>
  }
}
