import { SuperElement } from '@super-ts/dom';
import './index.css';

/** Home screen: the list of the app's examples. */
export class ExamplesScreen extends SuperElement {
  @tag = 'examples-screen';

  render() {
    <main class="screen">
      <h1>Super examples</h1>
      <ul class="examples">
        <li>
          <a href={this.router.href('counters')}>Counters</a>
          <p>A store and its selectors, commands and their outcome, persistence in localStorage, the router.</p>
        </li>
        <li>
          <a href={this.router.href('profile')}>Profile form</a>
          <p>Every type of field, rules, an asynchronous check, a dynamic list, simulated server errors.</p>
        </li>
        <li>
          <a href={this.router.href('shop')}>Shop</a>
          <p>A store that depends on another, a hand-written event, a confirmation dialog, a guard.</p>
        </li>
        <li>
          <a href={this.router.href('errors')}>Errors</a>
          <p>renderError, the '!' screen, action errors, and the log of what onError receives.</p>
        </li>
        <li>
          <a href={this.router.href('widget')}>Widget</a> <p>A second application in the page, mounted / unmounted, a keyboard shortcut.</p>
        </li>
        <li>
          <a href={this.router.href('composition')}>Composition</a>
          <p>Components that receive children, and the two ways to fill a slot: <code>{'<:actions>'}</code> or a method.</p>
        </li>
      </ul>
    </main>
  }
}
