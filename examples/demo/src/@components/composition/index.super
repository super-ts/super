import { SuperElement } from '@super-ts/dom';
import { Card } from './card';
import { Tabs } from './tabs';
import './index.css';

type Note = { id: number; text: string; pinned: boolean };

/**
 * Écran de la route `/composition` : un composant qui reçoit des enfants (Card, Tabs), et les deux
 * façons de remplir un emplacement nommé, un emplacement `<:actions>` ou une méthode `#actions()`.
 */
export class CompositionScreen extends SuperElement {
  @tag = 'composition-screen';
  @title = 'Composition';

  @state local = {
    likes: 0,
    notes: [
      { id: 1, text: 'Acheter du café', pinned: false },
      { id: 2, text: 'Relire la doc des .super', pinned: true },
      { id: 3, text: 'Arroser les plantes', pinned: false },
    ] as Note[],
  };

  togglePin = (id: number) => this.local.set((s) => ({ notes: s.notes.map((n) => (n.id === id ? { ...n, pinned: !n.pinned } : n)) }));
  removeNote = (id: number) => this.local.set((s) => ({ notes: s.notes.filter((n) => n.id !== id) }));

  // Une méthode qui émet des éléments remplit un emplacement : pratique dans une boucle, la note
  // arrive en paramètre.
  #actions(note: Note) {
    <button type="button" on:click={() => this.togglePin(note.id)}>{note.pinned ? 'Désépingler' : 'Épingler'}</button>
    <button type="button" class="danger" on:click={() => this.removeNote(note.id)}>Supprimer</button>
  }

  // Les panneaux des onglets : une liste d'emplacements, un par méthode.
  #general() {
    <p>Les enfants d’un composant s’écrivent entre ses balises et remplissent sa prop <code>content</code>.</p>
  }

  #details() {
    <p>Un emplacement nommé est une autre prop de type <code>Children</code>, remplie par <code>{'<:nom>'}</code> ou par une méthode.</p>
  }

  render() {
    const { likes, notes } = this.local.get();
    <main class="screen">
      <h1>Composition</h1>
      <p class="hint">
        Des composants qui reçoivent du contenu de leur parent. Le contenu reste celui du parent : ses boutons modifient son état à lui.
      </p>

      <Card heading="Des enfants">
        <p>Tout ce qui est écrit entre les balises de la carte remplit sa prop <code>content</code>.</p>
      </Card>

      <Card heading="Un emplacement <:actions>">
        <p>J’aime : {likes}</p>
        <:actions>
          <button type="button" on:click={() => this.local.set({ likes: likes + 1 })}>J’aime</button>
        </:actions>
      </Card>
      <h2>Une méthode #actions(note)</h2>
      if (notes.length === 0) {
        <p class="empty">Plus aucune note.</p>
      }
      for (const note of notes; key note.id) {
        <Card heading={note.pinned ? `📌 ${note.text}` : note.text} actions={this.#actions(note)}>
          <p>Note n° {note.id}</p>
        </Card>
      }

      <h2>Une liste d’emplacements</h2> <Tabs labels={['Enfants', 'Emplacements']} panels={[this.#general(), this.#details()]} />
    </main>
  }
}
