import { SuperElement } from '@super-ts/dom';
import { Card } from './card';
import { Tabs } from './tabs';
import './index.css';

type Note = { id: number; text: string; pinned: boolean };

/**
 * Screen of the `/composition` route: a component that receives children (Card, Tabs), and the two
 * ways to fill a named slot, a `<:actions>` slot or a `#actions()` method.
 */
export class CompositionScreen extends SuperElement {
  @tag = 'composition-screen';
  @title = 'Composition';

  @state local = {
    likes: 0,
    notes: [
      { id: 1, text: 'Buy coffee', pinned: false },
      { id: 2, text: 'Reread the .super docs', pinned: true },
      { id: 3, text: 'Water the plants', pinned: false },
    ] as Note[],
  };

  togglePin = (id: number) => this.local.set((s) => ({ notes: s.notes.map((n) => (n.id === id ? { ...n, pinned: !n.pinned } : n)) }));
  removeNote = (id: number) => this.local.set((s) => ({ notes: s.notes.filter((n) => n.id !== id) }));

  // A method that emits elements fills a slot: handy in a loop, the note
  // comes in as a parameter.
  #actions(note: Note) {
    <button type="button" on:click={() => this.togglePin(note.id)}>{note.pinned ? 'Unpin' : 'Pin'}</button>
    <button type="button" class="danger" on:click={() => this.removeNote(note.id)}>Delete</button>
  }

  // The tab panels: a list of slots, one per method.
  #general() {
    <p>A component's children are written between its tags and fill its <code>content</code> prop.</p>
  }

  #details() {
    <p>A named slot is another prop of type <code>Children</code>, filled by <code>{'<:name>'}</code> or by a method.</p>
  }

  render() {
    const { likes, notes } = this.local.get();
    <main class="screen">
      <h1>Composition</h1>
      <p class="hint">
        Components that receive content from their parent. The content still belongs to the parent: its buttons change the parent's state.
      </p>

      <Card heading="Children">
        <p>Everything written between the card's tags fills its <code>content</code> prop.</p>
      </Card>

      <Card heading="A <:actions> slot">
        <p>Likes: {likes}</p>
        <:actions>
          <button type="button" on:click={() => this.local.set({ likes: likes + 1 })}>Like</button>
        </:actions>
      </Card>
      <h2>A #actions(note) method</h2>
      if (notes.length === 0) {
        <p class="empty">No notes left.</p>
      }
      for (const note of notes; key note.id) {
        <Card heading={note.pinned ? `📌 ${note.text}` : note.text} actions={this.#actions(note)}>
          <p>Note no. {note.id}</p>
        </Card>
      }

      <h2>A list of slots</h2> <Tabs labels={['Children', 'Slots']} panels={[this.#general(), this.#details()]} />
    </main>
  }
}
