import { SuperElement } from '@super-ts/dom';
import { formatPrice } from '../../format';
import './index.css';

/**
 * Screen of the `/shop/checkout` route, protected by a guard: you only get here with a non-empty cart
 * (see routes.ts). The order is a command of the Checkout store, which depends on the cart.
 */
export class CheckoutScreen extends SuperElement {
  @tag = 'checkout-screen';
  @title = 'Order';

  @contract cart;
  @selector count = this.cart.selectors.count;
  @selector total = this.cart.selectors.total;
  @contract checkout;
  @selector lastOrder = this.checkout.selectors.lastOrder;

  @form order = {
    initial: { address: '' },
    rules: { address: (v) => v.trim().length >= 10 || 'Full address, 10 characters minimum' },
    submit: { to: this.checkout, command: 'placeOrder', toInput: ({ address }) => ({ address: address.trim() }) },
    failures: {
      fields: { 'payment-refused': { address: 'Payment refused for this billing address' } },
      form: { 'empty-cart': 'Your cart is empty.', network: 'Could not connect, try again.' },
    },
  };

  render() {
    const lastOrder = this.lastOrder.value;
    if (lastOrder) {
      <main class="screen">
        <h1>Order confirmed</h1>
        <p role="status">Order no. {lastOrder.orderId}, {formatPrice(lastOrder.total)}.</p>
        <a href={this.router.href('shop')}>Back to the shop</a>
      </main>
      return;
    }
    const count = this.count.value;
    const { order } = this;
    <main class="screen">
      <h1>Checkout</h1>
      <p>{count} item{count > 1 ? 's' : ''}, {formatPrice(this.total.value)}.</p>
      <p class="hint">
        Simulated server: an address containing <code>refuse</code> gets the payment refused, <code>offline</code> simulates a failure.
      </p>
      <form {order.bind()}>
        <label>Delivery address <textarea rows="3" {order.field('address')}></textarea></label>
        <p class="error">{order.error('address')}</p>
        <p role="alert" class="error">{order.formError()}</p>
        <div class="actions">
          <a href={this.router.href('shop')}>Back to the cart</a>
          <button disabled={order.submitting()}>{order.submitting() ? 'Placing order…' : 'Pay'}</button>
        </div>
      </form>
    </main>
  }
}
