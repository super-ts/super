import { SuperElement } from '@super-ts/dom';
import { DoubleFailure } from './double-failure';
import { FragileCard } from './fragile-card';
import { GuardedPanel } from './guarded-panel';
import './index.css';

/** Écran de la route `/errors` : provoque chaque cas, et affiche ce que reçoit `onError`. */
export class ErrorsScreen extends SuperElement {
  @tag = 'errors-screen';
  @title = 'Erreurs';

  @contract log = 'error-log';
  @selector entries = this.log.selectors.entries;
  @state local = { round: 0, broken: false, withChild: false, armed: false };

  restart = () => this.local.set((s) => ({ round: s.round + 1, broken: false, withChild: false, armed: false }));

  render() {
    const { local, restart } = this;
    const entries = this.entries.value;
    const { round, broken, withChild, armed } = local.get();
    <main class="screen">
      <h1>Erreurs</h1>
      <p class="hint">Chaque bouton provoque une erreur réelle. Le journal en bas montre ce que reçoit <code>onError</code>.</p>

      {/* Une boucle à une seule clé, `round` : « Recommencer » recrée les trois blocs. */}
      for (const _round of [round]; key _round) {
        <section>
          <h2>1. Un composant qui plante au rendu</h2>
          <FragileCard broken={broken} />
          <button type="button" on:click={() => local.set({ broken: true })}>Casser le bloc</button>
        </section>

        <section>
          <h2>2. Un enfant qui plante, rattrapé par son parent</h2>
          <GuardedPanel withChild={withChild} />
          <button type="button" on:click={() => local.set({ withChild: true })}>Afficher l'enfant cassé</button>
        </section>

        <section>
          <h2>3. Un renderError qui plante aussi</h2>
          <DoubleFailure armed={armed} />
          <button type="button" on:click={() => local.set({ armed: true })}>Tout casser (écran '!')</button>
        </section>
      }

      <section>
        <h2>4. Un clic qui plante</h2>
        <p>L'affichage ne change pas : l'erreur est seulement signalée (phase <code>event</code>).</p>
        <button type="button" on:click={() => { throw new Error('le gestionnaire de clic a planté'); }}>Clic qui plante</button>
      </section>

      <section class="log" aria-label="Journal onError">
        <h2>Journal de onError</h2>
        if (entries.length === 0) {
          <p class="empty">Aucune erreur pour l'instant.</p>
        } else {
          <ol>
            for (const [i, e] of entries.entries(); key i) {
              <li>
                <strong>{e.tag}</strong>, phase <code>{e.phase}</code>, rattrapée par <code>{e.caughtBy ?? 'personne'}</code> : {e.message}
              </li>
            }
          </ol>
        }
        <div class="actions">
          <button type="button" on:click={restart}>Recommencer</button>
          <button type="button" on:click={() => this.log.send('clear')}>Vider le journal</button>
        </div>
      </section>
    </main>
  }
}
