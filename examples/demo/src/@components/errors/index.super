import { SuperElement } from '@super-ts/dom';
import { DoubleFailure } from './double-failure';
import { FragileCard } from './fragile-card';
import { GuardedPanel } from './guarded-panel';
import './index.css';

/** Screen of the `/errors` route: triggers each case, and shows what `onError` receives. */
export class ErrorsScreen extends SuperElement {
  @tag = 'errors-screen';
  @title = 'Errors';

  @contract log = 'error-log';
  @selector entries = this.log.selectors.entries;
  @state local = { round: 0, broken: false, withChild: false, armed: false };

  restart = () => this.local.set((s) => ({ round: s.round + 1, broken: false, withChild: false, armed: false }));

  render() {
    const { local, restart } = this;
    const entries = this.entries.value;
    const { round, broken, withChild, armed } = local.get();
    <main class="screen">
      <h1>Errors</h1>
      <p class="hint">Each button triggers a real error. The log at the bottom shows what <code>onError</code> receives.</p>

      {/* A loop with a single key, `round`: "Start over" recreates the three blocks. */}
      for (const _round of [round]; key _round) {
        <section>
          <h2>1. A component that crashes on render</h2>
          <FragileCard broken={broken} />
          <button type="button" on:click={() => local.set({ broken: true })}>Break the block</button>
        </section>

        <section>
          <h2>2. A child that crashes, caught by its parent</h2>
          <GuardedPanel withChild={withChild} />
          <button type="button" on:click={() => local.set({ withChild: true })}>Show the broken child</button>
        </section>

        <section>
          <h2>3. A renderError that crashes too</h2>
          <DoubleFailure armed={armed} />
          <button type="button" on:click={() => local.set({ armed: true })}>Break everything ('!' screen)</button>
        </section>
      }

      <section>
        <h2>4. A click that crashes</h2>
        <p>The display does not change: the error is only reported (phase <code>event</code>).</p>
        <button type="button" on:click={() => { throw new Error('the click handler crashed'); }}>Click that crashes</button>
      </section>

      <section class="log" aria-label="onError log">
        <h2>onError log</h2>
        if (entries.length === 0) {
          <p class="empty">No errors yet.</p>
        } else {
          <ol>
            for (const [i, e] of entries.entries(); key i) {
              <li><strong>{e.tag}</strong>, phase <code>{e.phase}</code>, caught by <code>{e.caughtBy ?? 'nobody'}</code>: {e.message}</li>
            }
          </ol>
        }
        <div class="actions">
          <button type="button" on:click={restart}>Start over</button>
          <button type="button" on:click={() => this.log.send('clear')}>Clear the log</button>
        </div>
      </section>
    </main>
  }
}
