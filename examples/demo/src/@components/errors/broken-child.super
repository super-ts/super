import { SuperElement } from '@super-ts/dom';

/** 2. A child that crashes in its constructor, without renderError... */
export class BrokenChild extends SuperElement {
  @tag = 'broken-child';

  constructor() {
    super();
    throw new Error('the child did not find what it expected');
  }

  // Emits nothing: renders nothing (the constructor crashes first anyway).
  render() {}
}
