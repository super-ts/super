import { SuperElement } from '@super-ts/dom';
import { Button, Checkbox, CommandButton, commandOf, createToasts, Field, fieldOf, RadioGroup, Select, Toasts } from '@super-ts/ui';
import { KitPage } from './kit-page';

const COUNTRIES = [
  { value: 'FR', label: 'France' },
  { value: 'BE', label: 'Belgium' },
  { value: 'CH', label: 'Switzerland' },
];
const COMMAND_CODE = `<CommandButton
  command={commandOf(this.counter, 'reset', { id: 'coffees' })}
  pendingLabel="Resetting…"
>
  Reset the coffees to zero
</CommandButton>

// The outcome arrives as for any send:
@on('counter', 'reset:done')
onReset() {
  this.notices.show('Coffees reset to zero.');
}`;

const PLANS = [
  { value: 'free', label: 'Free' },
  { value: 'pro', label: 'Pro' },
  { value: 'team', label: 'Team' },
];

// What the profile expects on top of this small form.
const PROFILE_DEFAULTS = {
  password: 'password1',
  age: null,
  website: '',
  bio: '',
  languages: ['fr'],
  interests: [],
  birthdate: '',
  meetingTime: '',
  color: '#4f46e5',
  volume: 50,
  avatar: null,
  phones: [],
};

/** Screen of the `/kit/forms` route: fields bound to a form, a command button, the messages. */
export class KitFormsScreen extends SuperElement {
  @tag = 'kit-forms-screen';

  @contract counter;
  @contract profile;
  notices = createToasts();
  @selector coffees = () => this.counter.selectors.count('coffees');

  @form edit = {
    initial: { name: '', email: '', country: 'FR', newsletter: false, plan: 'free' as 'free' | 'pro' | 'team' },
    rules: {
      name: (v) => v.trim() !== '' || 'Name required',
      email: (v) => /.+@.+\..+/.test(v) || 'Invalid address',
    },
    checks: {
      email: {
        command: 'checkEmail',
        toInput: (email) => ({ email }),
        accept: ({ available }) => available || 'Address already in use',
        delay: 400,
      },
    },
    submit: { to: this.profile, command: 'save', toInput: (values) => ({ ...PROFILE_DEFAULTS, ...values }) },
    failures: {
      fields: { 'email-taken': { email: 'Address already in use' } },
      form: { network: 'Could not connect, try again.', 'avatar-too-large': 'Image too large.' },
    },
  };

  // Command outcomes become messages.
  @on('profile', 'save:done')
  onSaved() {
    this.notices.show('Profile saved.', { tone: 'success' });
  }

  @on('counter', 'reset:done')
  onReset() {
    this.notices.show('Coffees reset to zero.');
  }

  render() {
    const { edit } = this;
    <KitPage
      heading="Forms and commands"
      intro="Fields bind to the form through fieldOf, the button to a command through commandOf: the names are checked by the compiler."
    >
      <section class="kit-section">
        <h2>Fields</h2>
        <form class="kit-form" {edit.bind()}>
          <Field field={fieldOf(edit, 'name')} label="Name" hint="As it will be displayed." />
          <Field field={fieldOf(edit, 'email')} label="Email" type="email" hint="Try taken@example.com." />
          <Select field={fieldOf(edit, 'country')} label="Country" options={COUNTRIES} />
          <RadioGroup field={fieldOf(edit, 'plan')} label="Plan" options={PLANS} />
          <Checkbox field={fieldOf(edit, 'newsletter')} label="Receive the newsletter" />
          <p role="alert" class="super-field-error">{edit.formError()}</p>
          <Button type="submit" disabled={edit.submitting()}>
            Save
          </Button>
        </form>
      </section>
      <section class="kit-example">
        <h2>Command button</h2>
        <p>
          On click, CommandButton sends the command prepared by commandOf: here reset on the counter contract, with the input
          <code>{"{ id: 'coffees' }"}</code>. While the command is pending, the button is disabled (aria-busy) and shows pendingLabel. The
          result comes back through the store: the counter below updates, and reset:done triggers a message.
        </p>
        <pre class="kit-code"><code>{COMMAND_CODE}</code></pre>
        <p>Coffees: <strong>{this.coffees.value}</strong></p>
        <div class="kit-row">
          <CommandButton command={commandOf(this.counter, 'increment', { id: 'coffees' })} variant="secondary">
            +1 coffee
          </CommandButton>
          <CommandButton command={commandOf(this.counter, 'reset', { id: 'coffees' })} pendingLabel="Resetting…">
            Reset the coffees to zero
          </CommandButton>
        </div>
      </section>
      <Toasts of={this.notices} />
    </KitPage>
  }
}
