import type { Children } from '@super-ts/dom';
import { SuperElement } from '@super-ts/dom';
import { RouteLink } from '@super-ts/ui';
import './kit.css';

/** The shared layout of the kit pages: back to the table of contents, heading, introduction, content. */
export class KitPage extends SuperElement {
  @tag = 'kit-page';
  // Not a screen: every kit page goes through it, so it gives all of them their title.
  @title = () => this.heading;
  @prop heading: string;
  @prop intro: string;
  @prop content: Children;

  render() {
    <main class="screen">
      <div class="kit-page">
        <RouteLink to={{ to: 'kit' }}>
          ← The kit
        </RouteLink>
        <h1>{this.heading}</h1>
        <p class="kit-page-intro">{this.intro}</p>
        {this.content}
      </div>
    </main>
  }
}
