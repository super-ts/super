import { SuperElement } from '@super-ts/dom';
import { Badge, Button, columns, EmptyState, Table } from '@super-ts/ui';
import GLOBAL_CSS from '../../kit-theme.css?raw';
import { KitPage } from './kit-page';
import COMPACT_CSS from './theme-compact.css?raw';
import DARK_CSS from './theme-dark.css?raw';
import INSTANCE_CSS from './theme-instance.css?raw';
import RULE_CSS from './theme-rule.css?raw';
import ZONE_CSS from './theme-zone.css?raw';
import './theme-compact.css';
import './theme-dark.css';
import './theme-instance.css';
import './theme-rule.css';
import './theme-zone.css';

type Row = { id: string; label: string; count: number };
const COLUMNS = columns<Row>([
  { key: 'label', label: 'Counter', sortable: true },
  { key: 'count', label: 'Value', sortable: true, align: 'end' },
]);

/**
 * Screen of the `/kit/theme` route: how to override the kit's style. Each example shows the
 * CSS that produces it, read from the very file that is applied (`?raw`).
 */
export class KitThemeScreen extends SuperElement {
  @tag = 'kit-theme-screen';

  @contract counter;

  #sample() {
    <div class="kit-row">
      <Button>
        Primary
      </Button>
      <Button variant="secondary">
        Secondary
      </Button>
      <Badge tone="info">
        Badge
      </Badge>
    </div>
  }

  render() {
    const rows: Row[] = this.counter.selectors
      .catalog()
      .map((c) => ({ id: c.id, label: c.label, count: this.counter.selectors.count(c.id) }));
    <KitPage
      heading="Theme"
      intro="The kit puts its CSS in a separate layer and only uses zero-specificity selectors: any rule of the app wins, without !important."
    >
      <section class="kit-example">
        <h2>The whole app</h2>
        <p>The --super-* variables on :root, in src/kit-theme.css, loaded by main.ts. This is what gives the whole demo its indigo.</p>
        <pre class="kit-code"><code>{GLOBAL_CSS}</code></pre>
        {this.#sample()}
      </section>
      <section class="kit-example">
        <h2>A zone</h2> <pre class="kit-code"><code>{ZONE_CSS}</code></pre> <div class="kit-ocean">{this.#sample()}</div>
      </section>
      <section class="kit-example">
        <h2>The dark theme in a zone</h2>
        <p>Each kit colour has a light value and a dark value: the kit follows the element's color-scheme.</p>
        <pre class="kit-code"><code>{DARK_CSS}</code></pre>
        <div class="kit-dark-zone">
          {this.#sample()}
          <EmptyState title="No favourites">
            The secondary text stays readable on the dark background.
          </EmptyState>
        </div>
      </section>
      <section class="kit-example">
        <h2>A single component</h2>
        <pre class="kit-code"><code>{INSTANCE_CSS}</code></pre>
        <div class="kit-row">
          <Button>
            Without a class
          </Button>
          <Button class="kit-violet">
            With class="kit-violet"
          </Button>
        </div>
      </section>
      <section class="kit-example">
        <h2>An ordinary rule</h2> <pre class="kit-code"><code>{RULE_CSS}</code></pre> <div class="kit-caps">{this.#sample()}</div>
      </section>
      <section class="kit-example">
        <h2>A dense table</h2>
        <pre class="kit-code"><code>{COMPACT_CSS}</code></pre>
        <Table class="kit-compact" columns={COLUMNS} rows={rows} rowKey={(row) => row.id} />
      </section>
    </KitPage>
  }
}
