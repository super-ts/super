import { SuperElement } from '@super-ts/dom';
import { Button, ConfirmDialog, createToasts, Dialog, Modal, Toasts } from '@super-ts/ui';
import { KitPage } from './kit-page';

/** Screen of the `/kit/windows` route: a mounted window is open, the screen decides whether to render it. */
export class KitWindowsScreen extends SuperElement {
  @tag = 'kit-windows-screen';

  notices = createToasts();
  @state local = { window: null as 'dialog' | 'modal' | 'confirm' | null };

  #close = () => this.local.set({ window: null });

  render() {
    const open = this.local.get().window;
    <KitPage
      heading="Windows"
      intro="Escape and the cross close by default; closeOn configures each way, including a click on the backdrop."
    >
      <div class="kit-row">
        <Button variant="secondary" on:press={() => this.local.set({ window: 'dialog' })}>
          Open a dialog
        </Button>
        <Button variant="secondary" on:press={() => this.local.set({ window: 'modal' })}>
          Open a modal
        </Button>
        <Button variant="danger" on:press={() => this.local.set({ window: 'confirm' })}>
          Delete everything
        </Button>
      </div>
      if (open === 'dialog') {
        <Dialog title="Rename" on:close={this.#close}>
          <p>A dialog has content and actions.</p>
          <:actions>
            <Button variant="secondary" on:press={this.#close}>
              Cancel
            </Button>
            <Button on:press={this.#close}>
              Save
            </Button>
          </:actions>
        </Dialog>
      }
      if (open === 'modal') {
        <Modal title="About" closeOn={{ backdrop: true }} on:close={this.#close}>
          <p>A modal has no actions: Escape, the cross or a click on the backdrop closes it.</p>
        </Modal>
      }
      if (open === 'confirm') {
        <ConfirmDialog
          question="Delete all the counters?"
          confirmLabel="Delete"
          danger
          on:answered={({ confirmed }) => {
              this.#close();
              if (confirmed) this.notices.show('Just pretending.', { tone: 'error' });
            }}
        />
      }
      <Toasts of={this.notices} />
    </KitPage>
  }
}
