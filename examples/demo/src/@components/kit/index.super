import { SuperElement } from '@super-ts/dom';
import { RouteLink } from '@super-ts/ui';
import './kit.css';

/** Screen of the `/kit` route: the kit's table of contents, one page per component family. */
export class KitScreen extends SuperElement {
  @tag = 'kit-screen';
  @title = 'UI kit';

  render() {
    <main class="screen">
      <div class="kit-page">
        <h1>UI kit</h1>
        <p class="kit-page-intro">Each page shows a family of @super-ts/ui components, connected to the demo's stores.</p>
        <ul class="kit-families">
          <li>
            <RouteLink to={{ to: 'kit-forms' }}>
              Forms and commands
            </RouteLink>
            <p>Field, Select, Checkbox, RadioGroup, CommandButton, Toasts.</p>
          </li>
          <li>
            <RouteLink to={{ to: 'kit-windows' }}>
              Windows
            </RouteLink>
            <p>Dialog, Modal, ConfirmDialog.</p>
          </li>
          <li>
            <RouteLink to={{ to: 'kit-primitives' }}>
              Primitives
            </RouteLink>
            <p>Menu, Tabs, Disclosure, Tooltip, Popover, Combobox.</p>
          </li>
          <li>
            <RouteLink to={{ to: 'kit-display' }}>
              Display
            </RouteLink>
            <p>Button, Badge, Spinner, Skeleton, EmptyState, ErrorPanel.</p>
          </li>
          <li>
            <RouteLink to={{ to: 'kit-table' }}>
              Table
            </RouteLink>
            <p>A static table, and a table connected to an API, driven by the URL.</p>
          </li>
          <li>
            <RouteLink to={{ to: 'kit-theme' }}>
              Theme
            </RouteLink>
            <p>Overriding the kit's style: variables, zones, an instance, a rule.</p>
          </li>
        </ul>
      </div>
    </main>
  }
}
