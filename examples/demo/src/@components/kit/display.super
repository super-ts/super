import { SuperElement } from '@super-ts/dom';
import { Badge, Button, EmptyState, ErrorPanel, Skeleton, Spinner } from '@super-ts/ui';
import { KitPage } from './kit-page';

const SAMPLE_ERROR = new Error('The server is not responding.');

/** Screen of the `/kit/display` route: the display components. */
export class KitDisplayScreen extends SuperElement {
  @tag = 'kit-display-screen';

  render() {
    <KitPage heading="Display" intro="Components without a store: they display what they are given.">
      <section class="kit-section">
        <h2>Button</h2>
        <div class="kit-row">
          <Button>
            Primary
          </Button>
          <Button variant="secondary">
            Secondary
          </Button>
          <Button variant="danger">
            Danger
          </Button>
          <Button variant="ghost">
            Subtle
          </Button>
          <Button disabled>
            Disabled
          </Button>
        </div>
      </section>
      <section class="kit-section">
        <h2>Badge and Spinner</h2>
        <div class="kit-row">
          <Badge>
            Neutral
          </Badge>
          <Badge tone="info">
            Info
          </Badge>
          <Badge tone="success">
            Active
          </Badge>
          <Badge tone="warning">
            Waiting
          </Badge>
          <Badge tone="danger">
            Blocked
          </Badge>
          <Spinner size="small" />
          <Spinner />
          <Spinner size="large" />
        </div>
      </section>
      <section class="kit-section"><h2>Skeleton</h2> <Skeleton lines={3} /></section>
      <section class="kit-section">
        <h2>EmptyState</h2>
        <EmptyState title="No favourites">
          Add a counter to your favourites to find it here.
          <:action>
            <Button variant="secondary">
              Browse
            </Button>
          </:action>
        </EmptyState>
      </section>
      <section class="kit-section"><h2>ErrorPanel</h2> <ErrorPanel error={SAMPLE_ERROR} path="/kit/display" /></section>
    </KitPage>
  }
}
