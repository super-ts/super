import { SuperElement } from '@super-ts/dom';
import './index.css';

const COUNTRIES = [
  { code: 'FR', label: 'France' },
  { code: 'BE', label: 'Belgium' },
  { code: 'CH', label: 'Switzerland' },
  { code: 'CA', label: 'Canada' },
];
const LANGUAGES = [
  { code: 'fr', label: 'French' },
  { code: 'en', label: 'English' },
  { code: 'es', label: 'Spanish' },
];
const INTERESTS = [
  { value: 'sport', label: 'Sport' },
  { value: 'reading', label: 'Reading' },
  { value: 'music', label: 'Music' },
];

/** Screen of the `/profile` route: a form with every type of field, submitted to a simulated server. */
export class ProfileScreen extends SuperElement {
  @tag = 'profile-screen';
  @title = 'Profile';

  // The store is only used to send commands and follow their outcome: nothing is read from it.
  @contract profile;
  @state local = { saved: null as string | null };

  @form edit = {
    // The initial values give the type of each field.
    initial: {
      name: '',
      email: '',
      password: '',
      confirm: '',
      age: null as number | null,
      website: '',
      bio: '',
      country: 'FR',
      languages: [] as string[],
      plan: 'free' as 'free' | 'pro' | 'team',
      newsletter: false,
      interests: [] as string[],
      birthdate: '',
      meetingTime: '',
      color: '#4f46e5',
      volume: 50,
      avatar: null as File | null,
      phones: [{ label: 'mobile', number: '' }],
    },

    // One rule per field: `true`, or the error message.
    rules: {
      name: (v) => v.trim() !== '' || 'Name required',
      email: (v) => /.+@.+\..+/.test(v) || 'Invalid address',
      password: (v) => v.length >= 8 || '8 characters minimum',
      age: (v) => v === null || (v >= 13 && v <= 120) || 'Between 13 and 120 years old',
      website: (v) => v === '' || /^https?:\/\/.+/.test(v) || 'Address starting with http:// or https://',
      bio: (v) => v.length <= 280 || '280 characters maximum',
      languages: (v) => v.length > 0 || 'Choose at least one language',
      avatar: (v) => v === null || v.type.startsWith('image/') || 'Choose an image',
      phones: { number: (v) => /^\+?[0-9 ]{6,}$/.test(v) || 'Invalid number' },
    },

    // The rules that span several fields.
    validate: (v) => ({
      ...(v.password === v.confirm ? {} : { confirm: 'The passwords differ' }),
      ...(v.phones.length > 0 ? {} : { phones: 'At least one number' }),
    }),

    // The asynchronous check of the address, while typing.
    checks: {
      email: {
        command: 'checkEmail',
        toInput: (email) => ({ email }),
        accept: ({ available }) => available || 'Address already in use',
        delay: 400,
      },
    },

    // The submission is a command: `confirm` is only for the screen, so it is removed.
    submit: { to: this.profile, command: 'save', toInput: ({ confirm, ...values }) => values },

    // Each failure reason of `save`, on a field or on the form.
    failures: {
      fields: {
        'email-taken': { email: 'Address already in use' },
        'avatar-too-large': { avatar: 'Image too large (1 MB maximum)' },
      },
      form: { network: 'Could not connect, try again.' },
    },
  };

  phones = this.edit.list('phones');

  @on('profile', 'save:done')
  onSaved({ result }) {
    this.local.set({ saved: result.id });
  }

  render() {
    const { edit, phones, local } = this;
    <main class="screen">
      <h1>Profile form</h1>
      <p class="hint">
        The server is simulated. Try <code>taken@example.com</code> (address already taken), an address containing <code>offline</code>
        (network failure), or an image larger than 1 MB.
      </p>

      <form {edit.bind()}>
        <fieldset>
          <legend>Identity</legend>
          <label>Name <input {edit.field('name')} /></label>
          <p class="error">{edit.error('name')}</p>

          <label>Email <input type="email" {edit.field('email')} /></label>
          if (edit.checking('email')) {
            <small class="checking">Checking…</small>
          }
          <p class="error">{edit.error('email')}</p>

          <label>Password <input type="password" {edit.field('password')} /></label>
          <p class="error">{edit.error('password')}</p>
          <label>Confirmation <input type="password" {edit.field('confirm')} /></label>
          <p class="error">{edit.error('confirm')}</p>

          <label>Age <input type="number" {edit.field('age')} /></label>
          <p class="error">{edit.error('age')}</p>

          <label>Website <input type="url" {edit.field('website')} /></label>
          <p class="error">{edit.error('website')}</p>

          <label>About you <textarea rows="3" {edit.field('bio')}></textarea></label>
          <p class="error">{edit.error('bio')}</p>
        </fieldset>

        <fieldset>
          <legend>Preferences</legend>
          <label>
            Country
            <select {edit.field('country')}>
              for (const c of COUNTRIES; key c.code) {
                <option value={c.code}>{c.label}</option>
              }
            </select>
          </label>

          <label>
            Languages
            <select multiple {edit.field('languages')}>
              for (const l of LANGUAGES; key l.code) {
                <option value={l.code}>{l.label}</option>
              }
            </select>
          </label>
          <p class="error">{edit.error('languages')}</p>

          <fieldset class="inline">
            <legend>Plan</legend>
            <label><input type="radio" {edit.field('plan', 'free')} /> Free</label>
            <label><input type="radio" {edit.field('plan', 'pro')} /> Pro</label>
            <label><input type="radio" {edit.field('plan', 'team')} /> Team</label>
          </fieldset>

          <label class="inline"><input type="checkbox" {edit.field('newsletter')} /> Receive the newsletter</label>

          <fieldset class="inline">
            <legend>Interests</legend>
            for (const i of INTERESTS; key i.value) {
              <label><input type="checkbox" {edit.field('interests', i.value)} /> {i.label}</label>
            }
          </fieldset>
        </fieldset>

        <fieldset>
          <legend>Dates, colour, volume, avatar</legend>
          <label>Date of birth <input type="date" {edit.field('birthdate')} /></label>
          <label>Meeting time <input type="time" {edit.field('meetingTime')} /></label>
          <label>Favourite colour <input type="color" {edit.field('color')} /></label>
          <label>Volume ({edit.values().volume}) <input type="range" min="0" max="100" {edit.field('volume')} /></label>
          <label>Avatar <input type="file" accept="image/*" {edit.field('avatar')} /></label>
          <p class="error">{edit.error('avatar')}</p>
        </fieldset>

        <fieldset>
          <legend>Phones</legend>
          for (const item of phones.items(); key item.key) {
            <div class="phone">
              <select aria-label="Number type" {item.field('label')}>
                <option value="mobile">mobile</option><option value="work">work</option><option value="home">home</option>
              </select>
              <input type="tel" aria-label="Number" {item.field('number')} />
              <button type="button" on:click={() => phones.remove(item)}>Remove</button>
              <p class="error">{item.error('number')}</p>
            </div>
          }
          <p class="error">{edit.error('phones')}</p>
          <button type="button" on:click={() => phones.add({ label: 'mobile', number: '' })}>Add a number</button>
        </fieldset>

        <p role="alert" class="form-error">{edit.formError()}</p>
        <p role="status" class="saved">{local.get().saved ? `Profile saved (no. ${local.get().saved}).` : ''}</p>

        <div class="actions">
          <button type="button" on:click={() => (edit.reset(), local.set({ saved: null }))}>Clear all</button>
          <button type="submit" disabled={edit.submitting()}>{edit.submitting() ? 'Saving…' : 'Save'}</button>
        </div>
      </form>
    </main>
  }
}
