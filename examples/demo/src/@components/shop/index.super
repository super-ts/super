import { SuperElement } from '@super-ts/dom';
import { formatPrice } from '../../format';
import { ConfirmDialog } from '../shared/confirm-dialog';
import './index.css';

/** Screen of the `/shop` route: the catalogue and the cart. */
export class ShopScreen extends SuperElement {
  @tag = 'shop-screen';
  // Tracked: the tab title changes with the cart, like the render.
  @title = () => {
    const count = this.cart.selectors.count();
    return count > 0 ? `Shop (${count} in cart)` : 'Shop';
  };

  @contract cart;
  @selector catalog = this.cart.selectors.catalog;
  @selector lines = this.cart.selectors.lines;
  @selector total = this.cart.selectors.total;
  @selector isEmpty = this.cart.selectors.isEmpty;
  // The open dialog (none: null), and a one-off message.
  @state local = { dialog: null as 'confirm-clear' | null, message: null as string | null };

  // The event written by hand by the store: the cart has just been emptied.
  @on('cart', 'emptied')
  onEmptied() {
    this.local.set({ message: 'Your cart is empty.' });
  }

  @on('cart', 'add:done')
  onAdded() {
    this.local.set({ message: null });
  }

  // The dialog answers with an event: the parent decides what happens next.
  onClearAnswered = ({ confirmed }: { confirmed: boolean }) => {
    this.local.set({ dialog: null });
    if (confirmed) this.cart.send('clear');
  };

  render() {
    <main class="screen">
      <h1>Shop</h1>
      <ul class="products">
        for (const p of this.catalog.value; key p.sku) {
          <li>
            <span>{p.label}</span>
            <span class="price">{formatPrice(p.price)}</span>
            <button type="button" aria-label={`Add ${p.label}`} on:click={() => this.cart.send('add', { sku: p.sku })}>Add</button>
          </li>
        }
      </ul>

      <section class="cart" aria-label="Cart">
        <h2>Cart</h2>
        if (this.isEmpty.value) {
          <p class="empty">{this.local.get().message ?? 'No items yet.'}</p>
        } else {
          <ul>
            for (const l of this.lines.value; key l.product.sku) {
              const { product, quantity } = l;
              <li>
                <span>{product.label}</span>
                <span class="quantity">
                  <button
                    type="button"
                    aria-label={`Remove one ${product.label}`}
                    on:click={() => this.cart.send('remove', { sku: product.sku })}
                  >
                    −
                  </button>
                  {quantity}
                  <button
                    type="button"
                    aria-label={`Add one ${product.label}`}
                    on:click={() => this.cart.send('add', { sku: product.sku })}
                  >
                    +
                  </button>
                </span>
                <span class="price">{formatPrice(l.subtotal)}</span>
              </li>
            }
          </ul>
          <p class="total">Total: <strong>{formatPrice(this.total.value)}</strong></p>
          <div class="actions">
            <button type="button" on:click={() => this.local.set({ dialog: 'confirm-clear' })}>Empty the cart</button>
            <a class="button" href={this.router.href('checkout')}>Checkout</a>
          </div>
        }
      </section>

      if (this.local.get().dialog === 'confirm-clear') {
        <ConfirmDialog question="Empty the cart?" on:answered={this.onClearAnswered} />
      }
    </main>
  }
}
