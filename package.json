{
  "name": "super",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Minimalist front-end framework: typed stores on EventTarget and typed HTMLElement components.",
  "license": "MIT",
  "workspaces": [
    "packages/core",
    "packages/dom",
    "packages/ui",
    "packages/testing",
    "packages/vite",
    "packages/lang",
    "packages/lang-server",
    "packages/lint"
  ],
  "scripts": {
    "dev": "vite --configLoader native",
    "build": "node scripts/build.mjs",
    "smoke": "node scripts/smoke-install.mjs",
    "changeset": "changeset",
    "release": "npm run build && changeset publish",
    "build:example": "vite build --configLoader native",
    "test": "vitest run --configLoader native",
    "test:watch": "vitest --configLoader native",
    "typecheck": "node packages/lang/src/cli.ts tsconfig.json && node packages/lang/src/cli.ts examples/demo/tsconfig.json",
    "check": "npm run lint && npm run typecheck && npm run test && npm run docs:index",
    "docs:index": "node docs/tools/build-docs-index.mjs",
    "docs": "npm run docs:index && node docs/tools/serve.mjs",
    "docs:check": "node docs/tools/build-docs-index.mjs --check",
    "lint": "biome check && node packages/lang/src/format-cli.ts --check",
    "lint:fix": "biome check --write && node packages/lang/src/format-cli.ts --write",
    "format": "biome format --write && node packages/lang/src/format-cli.ts --write"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.9",
    "@changesets/cli": "^2.31.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/user-event": "^14.6.13",
    "happy-dom": "^21.0.4",
    "rolldown": "^1.2.19",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  }
}
