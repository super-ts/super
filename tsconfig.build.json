{
  // Build base for the published packages (see scripts/build.mjs): each package extends it and
  // emits src/ to dist/. No `paths` and no `@super-ts/source` condition here: a package
  // reads its @super-ts/* dependencies through their dist/*.d.ts, as a user's project would.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": [],
    "declaration": true,
    "rewriteRelativeImportExtensions": true,
    "noEmitOnError": true
  }
}
