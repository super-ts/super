import { type Children, SuperElement } from '@super-ts/dom';

/** A component with children and a named slot, for `<:` completion. */
export class Panel extends SuperElement {
  @tag = 'srv-panel';
  @prop heading: string;
  @prop content: Children;
  @prop footer?: Children;

  render() {
    <section>{this.content} <footer>{this.footer}</footer></section>
  }
}
