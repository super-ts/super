import { type Children, SuperElement } from '@super-ts/dom';

/** A component that receives children (required) and a named slot (optional). */
export class Panel extends SuperElement {
  @tag = 'lang-project-panel';
  @prop heading: string;
  @prop content: Children;
  @prop footer?: Children;

  render() {
    <section>
      <h2>{this.heading}</h2> {this.content}
      if (this.footer) {
        <footer>{this.footer}</footer>
      }
    </section>
  }
}
