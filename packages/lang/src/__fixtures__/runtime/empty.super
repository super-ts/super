import { SuperElement } from '@super-ts/dom';

/** Renders nothing at all. */
export class Empty extends SuperElement {
  @tag = 'lang-empty';

  render() {}
}

/** Renders nothing while `shown` is false, then a paragraph. */
export class Toggled extends SuperElement {
  @tag = 'lang-toggled';
  @state local = { shown: false };

  render() {
    if (this.local.get().shown) {
      <p>Visible</p>
    }
  }
}
