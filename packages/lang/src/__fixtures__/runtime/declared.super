import { SuperElement } from '@super-ts/dom';

/** A component that declares everything in its class: tag, page title, props (with a default) and event. */
export class Declared extends SuperElement {
  @tag = 'lang-declared';
  @title = () => `Label ${this.label}`;
  @prop label: string;
  @prop tone: 'neutral' | 'danger' = 'neutral';
  @prop tags: string[] = [];
  @emit picked: { label: string };

  render() {
    <button type="button" class={this.tone} on:click={() => this.emit('picked', { label: this.label })}>{this.label}</button>
  }
}
