import { SuperElement } from '@super-ts/dom';

/** A child component written in .super, with props and an event. */
export class Badge extends SuperElement {
  @tag = 'lang-badge';
  @prop label: string;
  @emit picked: { label: string };

  render() {
    <button type="button" class="badge" on:click={() => this.emit('picked', { label: this.label })}>{this.label}</button>
  }
}
