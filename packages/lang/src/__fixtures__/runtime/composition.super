import { type Children, SuperElement } from '@super-ts/dom';

/** Receives children and a named slot, and places them. */
export class Panel extends SuperElement {
  @tag = 'lang-panel';
  @prop heading: string;
  @prop content: Children;
  @prop footer?: Children;
  @state local = { open: true };

  render() {
    <section class="panel">
      <h2>{this.heading} <button class="toggle" on:click={() => this.local.set({ open: !this.local.get().open })}>toggle</button></h2>
      if (this.local.get().open) {
        <div class="body">{this.content}</div>
      }
      if (this.footer) {
        <footer>{this.footer}</footer>
      }
    </section>
  }
}

/** Fills the panel: children, a footer from a method, a footer from a slot. */
export class Composition extends SuperElement {
  @tag = 'lang-composition';
  @state local = { clicks: 0 };

  #footer() {
    <small class="by-method">by a method ({this.local.get().clicks})</small>
  }

  render() {
    const { clicks } = this.local.get();
    <Panel heading="First" footer={this.#footer()}>
      <p class="child">Clicks: {clicks}</p> <button class="add" on:click={() => this.local.set({ clicks: clicks + 1 })}>+1</button>
    </Panel>
    <Panel heading="Second">
      <p class="second">no footer from a method</p>
      <:footer>
        <em class="by-slot">by a slot</em>
      </:footer>
    </Panel>
  }
}
